<?xml version="1.0" encoding="utf-8"?>
<!-- Every AlertDialog's card (Theme.Mrowser.Dialog). The 10dp side inset is a transparent margin
     the stock decor pads its content by, so the content stays flush with the card. It exists only
     because ViewRootImpl measures a wrap-content window at config_prefDialogWidth (440dp on a
     "large" screen, which every 960x540dp TV is) and a ListView or a long message fills that, so a
     list dialog's window is 440dp whatever windowMinWidth says (there is no public cap): 440 - 2 x 10
     keeps that card at 420dp, the same as every other dialog.
     No top/bottom inset, and nothing wider: Fire OS lays dialogs out with its own layout, which put
     the content in the old 16dp all-round margin, where the card's edge cropped it (#65). -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="10dp"
    android:insetRight="10dp">
    <shape android:shape="rectangle">
        <corners android:radius="20dp" />
        <solid android:color="@color/dialog_card" />
        <stroke android:width="1dp" android:color="@color/hairline" />
    </shape>
</inset>
