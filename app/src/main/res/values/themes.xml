<resources>
    <style name="Theme.Mrowser" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorControlActivated">@color/accent</item>
        <item name="android:textColorPrimary">@color/on_surface</item>
        <item name="android:textColorHint">@color/hint</item>
        <!-- Every AlertDialog in the app, PlayerActivity's and media3's track pickers included,
             resolves its theme from here. -->
        <item name="android:alertDialogTheme">@style/Theme.Mrowser.Dialog</item>
    </style>

    <!--
        The dialogs in the capsule bar's style: a rounded dark card, pill buttons that turn white
        under the D-pad, rounded list rows, and an accent dot for the checked choice. Only public
        theme attributes are used, so the framework keeps its own dialog layout.
    -->
    <style name="Theme.Mrowser.Dialog" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_background</item>
        <!-- A 420dp card + the background's 10dp side inset each side = config_prefDialogWidth
             on a large screen, the width a list or long-message dialog's window takes anyway,
             so every dialog gets the same 420dp card. A minimum, not a cap: windowFixedWidth* are
             private attributes. (On the TV a long message still wraps at the card width.) -->
        <item name="android:windowMinWidthMajor">440dp</item>
        <item name="android:windowMinWidthMinor">440dp</item>
        <item name="android:dialogPreferredPadding">26dp</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorControlActivated">@color/accent</item>
        <item name="android:colorControlNormal">@color/hint</item>

        <item name="android:windowTitleStyle">@style/Mrowser.DialogTitle</item>
        <!-- The message TextView's style is the private TextAppearance.Material.Subhead, whose
             colour is ?textColorPrimary — the only public lever on the message. -->
        <item name="android:textColorPrimary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/hint</item>

        <item name="android:buttonBarStyle">@style/Widget.Mrowser.DialogButtonBar</item>
        <item name="android:buttonBarButtonStyle">@style/Widget.Mrowser.DialogButton</item>

        <item name="android:listViewStyle">@style/Widget.Mrowser.DialogList</item>
        <item name="android:listDividerAlertDialog">@drawable/dialog_row_gap</item>
        <item name="android:listChoiceBackgroundIndicator">@drawable/dialog_row_bg</item>
        <item name="android:selectableItemBackground">@drawable/dialog_view_row_bg</item>
        <item name="android:listPreferredItemHeightSmall">46dp</item>
        <!-- A ListView row already starts at the white row's edge (the list pads its rows by
             the selector's inset), so its text sits 14dp in, as in the design. -->
        <item name="android:listPreferredItemPaddingStart">14dp</item>
        <item name="android:listPreferredItemPaddingEnd">14dp</item>
        <item name="android:listPreferredItemPaddingLeft">14dp</item>
        <item name="android:listPreferredItemPaddingRight">14dp</item>
        <item name="android:textColorAlertDialogListItem">@color/dialog_item_text</item>
        <item name="android:textAppearanceListItemSmall">@style/TextAppearance.Mrowser.DialogItem</item>
        <!-- select_dialog_singlechoice_material sizes its rows with textAppearanceMedium. -->
        <item name="android:textAppearanceMedium">@style/TextAppearance.Mrowser.DialogItem</item>
        <item name="android:listChoiceIndicatorSingle">@drawable/dialog_choice_dot</item>

        <item name="android:editTextStyle">@style/Widget.Mrowser.DialogField</item>
    </style>

    <style name="Mrowser.DialogTitle" parent="">
        <item name="android:maxLines">1</item>
        <item name="android:scrollHorizontally">true</item>
        <item name="android:textAppearance">@style/TextAppearance.Mrowser.DialogTitle</item>
    </style>

    <style name="TextAppearance.Mrowser.DialogTitle" parent="@android:style/TextAppearance.Material.Title">
        <item name="android:textSize">21sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>

    <style name="TextAppearance.Mrowser.DialogItem" parent="@android:style/TextAppearance.Material.Subhead">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/dialog_item_text</item>
    </style>

    <!-- The dialog's button row. Tuned for the leanback dialog layout Android TV uses, where this
         style lands on the ButtonBarLayout itself (left-aligned: positive, negative, gap,
         neutral): the first button's 8dp margin + 18dp = the 26dp content inset. clipToPadding
         is off so a focused button's 1.05 scale is not cut by the padding. -->
    <style name="Widget.Mrowser.DialogButtonBar" parent="">
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">26dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">20dp</item>
        <item name="android:clipToPadding">false</item>
    </style>

    <!-- A dialog button. Also built by hand for FavoriteDialog's move row. -->
    <style name="Widget.Mrowser.DialogButton" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:background">@drawable/pill_bg</item>
        <item name="android:textColor">@color/pill_content</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">42dp</item>
        <item name="android:minWidth">64dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:stateListAnimator">@animator/pill_focus_scale</item>
    </style>

    <style name="Widget.Mrowser.DialogList" parent="@android:style/Widget.Material.ListView">
        <item name="android:listSelector">@drawable/dialog_row_bg</item>
        <item name="android:divider">@drawable/dialog_row_gap</item>
        <item name="android:dividerHeight">4dp</item>
    </style>

    <style name="Widget.Mrowser.DialogField" parent="@android:style/Widget.Material.EditText">
        <item name="android:background">@drawable/dialog_field_bg</item>
        <item name="android:minHeight">46dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textColorHint">@color/hint</item>
    </style>
</resources>
