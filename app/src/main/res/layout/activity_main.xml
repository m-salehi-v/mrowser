<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <net.mrowser.web.CursorLayout
        android:id="@+id/cursorLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Page-load progress: scaled from the left edge by MainActivity. Over the page, under
             the bar and the chip. -->
        <View
            android:id="@+id/loadingLine"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_gravity="top"
            android:background="@color/accent"
            android:visibility="gone" />

        <!-- The capsule address bar. Left to right is also the D-pad order; the edge
             controls point their outward next-focus at themselves, so focus cannot leave the
             bar for the WebView / cursor layer behind it. clipToPadding is off so a focused end
             button's 1.08 scale can spill into the padding instead of being cut. -->
        <LinearLayout
            android:id="@+id/chromeBar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_gravity="top"
            android:layout_marginTop="16dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bar_background"
            android:elevation="10dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/backButton"
                style="@style/Widget.Mrowser.BarIcon"
                android:layout_marginStart="0dp"
                android:nextFocusLeft="@id/backButton"
                android:nextFocusUp="@id/backButton"
                android:nextFocusDown="@id/backButton"
                android:src="@drawable/ic_back"
                android:contentDescription="@string/back" />

            <ImageButton
                android:id="@+id/reloadButton"
                style="@style/Widget.Mrowser.BarIcon"
                android:nextFocusUp="@id/reloadButton"
                android:nextFocusDown="@id/reloadButton"
                android:src="@drawable/ic_reload"
                android:contentDescription="@string/reload" />

            <ImageButton
                android:id="@+id/homeButton"
                style="@style/Widget.Mrowser.BarIcon"
                android:nextFocusUp="@id/homeButton"
                android:nextFocusDown="@id/homeButton"
                android:src="@drawable/ic_home"
                android:contentDescription="@string/home" />

            <View style="@style/Widget.Mrowser.BarSeparator" />

            <EditText
                android:id="@+id/urlInput"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:nextFocusUp="@id/urlInput"
                android:nextFocusDown="@id/urlInput"
                android:background="@drawable/url_field_bg"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:gravity="center_vertical"
                android:drawablePadding="8dp"
                android:singleLine="true"
                android:textSize="17sp"
                android:hint="@string/url_hint"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:textColor="@color/on_surface"
                android:textColorHint="@color/hint" />

            <View style="@style/Widget.Mrowser.BarSeparator" />

            <ImageButton
                android:id="@+id/favoriteButton"
                style="@style/Widget.Mrowser.BarIcon"
                android:nextFocusUp="@id/favoriteButton"
                android:nextFocusDown="@id/favoriteButton"
                android:src="@drawable/ic_star"
                android:contentDescription="@string/add_favorite" />

            <!-- Shield + blocked-count badge. The children copy the frame's focused state, so
                 the icon tint and the badge fill follow its focus. -->
            <FrameLayout
                android:id="@+id/adBlockButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:nextFocusUp="@id/adBlockButton"
                android:nextFocusDown="@id/adBlockButton"
                android:background="@drawable/bar_icon_bg"
                android:stateListAnimator="@animator/bar_focus_scale"
                android:focusable="true"
                android:clickable="true"
                android:contentDescription="@string/ad_block_button">

                <ImageView
                    android:id="@+id/adBlockIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:duplicateParentState="true"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_shield"
                    android:tint="@color/bar_icon_tint" />

                <TextView
                    android:id="@+id/adBlockCount"
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="2dp"
                    android:minWidth="18dp"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:duplicateParentState="true"
                    android:importantForAccessibility="no"
                    android:background="@drawable/badge_bg"
                    android:textColor="@color/on_surface"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>

            <ImageButton
                android:id="@+id/historyButton"
                style="@style/Widget.Mrowser.BarIcon"
                android:nextFocusRight="@id/historyButton"
                android:nextFocusUp="@id/historyButton"
                android:nextFocusDown="@id/historyButton"
                android:src="@drawable/ic_history"
                android:contentDescription="@string/history" />
        </LinearLayout>

        <!-- A capsule with an accent play button; CursorLayout hit-tests its bounds for OK. -->
        <TextView
            android:id="@+id/playChip"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="36dp"
            android:background="@drawable/chip_bg"
            android:elevation="10dp"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="22dp"
            android:drawableStart="@drawable/ic_play_chip"
            android:drawablePadding="12dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/play_synced"
            android:textColor="@color/on_surface"
            android:textSize="17sp"
            android:visibility="gone" />
    </net.mrowser.web.CursorLayout>

    <!-- Why a page didn't load. Outside CursorLayout, whose dispatchKeyEvent would take the
         D-pad; over the page and under the overlays (it ranks below them in OverlayFocus). -->
    <net.mrowser.web.PageErrorView
        android:id="@+id/pageErrorView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <net.mrowser.home.HomeView
        android:id="@+id/homeView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <net.mrowser.home.HistoryView
        android:id="@+id/historyView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <net.mrowser.home.SettingsView
        android:id="@+id/settingsView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
</FrameLayout>
